---
const steps = [
  { t: 'Pahami', d: 'Kami memetakan masalah, pengguna, dan target sebelum satu baris kode ditulis.' },
  { t: 'Rancang', d: 'Alur, tampilan, dan arsitektur disepakati bersama lewat prototipe yang bisa dicoba.' },
  { t: 'Bangun', d: 'Pengembangan bertahap dengan rilis rutin, sehingga Anda melihat kemajuan nyata.' },
  { t: 'Rawat', d: 'Pemantauan, perbaikan, dan pengembangan lanjutan setelah produk berjalan.' },
];
---
<section class="section" id="proses">
  <div class="wrap">
    <p class="eyebrow reveal">Cara kerja</p>
    <h2 class="h2 reveal" style="--i:1">Empat langkah, satu arah.</h2>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; padding: 0; margin-top: clamp(2.5rem, 6vw, 4.5rem); display: grid; gap: 2.5rem 2rem; grid-template-columns: repeat(4, minmax(0, 1fr)); counter-reset: s; }
  .steps li { border-top: 2px solid var(--ink); padding-top: 1.25rem; position: relative; }
  .steps li::before { content: ''; position: absolute; top: -2px; left: 0; height: 2px; width: 100%; background: var(--blue); transform: scaleX(0); transform-origin: left; transition: transform 1s 0.3s var(--ease); }
  .steps li.in::before { transform: scaleX(1); }
  .n { font: 500 0.8rem/1 var(--f-mono); color: var(--blue); }
  h3 { font: 600 1.75rem/1.1 var(--f-display); letter-spacing: -0.025em; margin-block: 1rem 0.6rem; }
  p { opacity: 0.8; font-size: 0.975rem; }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) { .steps { grid-template-columns: 1fr; } }
</style>

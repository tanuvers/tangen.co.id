---
import { SHAPES } from './shapes';
const links = [
  { href: '#lini', label: 'Lini kerja' },
  { href: '#tentang', label: 'Tentang' },
  { href: '#proses', label: 'Cara kerja' },
  { href: '#aktivitas', label: 'Aktivitas' },
];
---
<footer>
  <svg class="ghost" viewBox="-12 -8 283 186" aria-hidden="true">
    <g transform="skewX(-5)" fill="currentColor">
      {Object.values(SHAPES).map((d) => <path d={d} />)}
    </g>
  </svg>

  <div class="wrap top">
    <div class="brand-col">
      <a class="brand" href="#top" aria-label="PT Tangen Universal Teknologi, ke atas">
        <svg class="mark-icon" viewBox="-12 -8 283 186" width="28" height="28" aria-hidden="true">
          <g transform="skewX(-5)" fill="currentColor">
            {Object.values(SHAPES).map((d) => <path d={d} />)}
          </g>
        </svg>
        <span>Tangen</span>
      </a>
      <p class="tagline">Mitra teknologi Anda di bidang bisnis, rekayasa, dan edukasi.</p>
    </div>

    <nav class="col" aria-label="Navigasi footer">
      <p class="col-title">Navigasi</p>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="col">
      <p class="col-title">Kontak</p>
      <a href="mailto:halo@tangen.co.id">halo@tangen.co.id</a>
      <a href="https://wa.me/6281997357609" target="_blank" rel="noopener">+62 819-9735-7609</a>
      <a
        href="https://www.google.com/maps/search/?api=1&query=Jl.+Menganti+No.+728A+Kec.+Menganti+Kab.+Gresik"
        target="_blank"
        rel="noopener"
        class="address"
      >
        Jl. Menganti No. 728A, Kec. Menganti, Kab. Gresik
      </a>
    </div>
  </div>

  <div class="wrap bottom">
    <p>© {new Date().getFullYear()} PT Tangen Universal Teknologi. Seluruh hak dilindungi.</p>
  </div>
</footer>

<style>
  footer { position: relative; overflow: clip; background: var(--ink); color: var(--cream); }
  .ghost { position: absolute; left: -6%; bottom: -22%; width: min(34rem, 60vw); color: var(--cream); opacity: 0.05; pointer-events: none; }

  .top {
    position: relative;
    display: grid; gap: 2.5rem clamp(2rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.7fr) minmax(0, 0.7fr);
    padding-block: clamp(3rem, 7vw, 4.5rem) clamp(2.5rem, 5vw, 3rem);
  }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; font: 600 1.15rem/1 var(--f-display); letter-spacing: -0.02em; color: var(--cream); }
  .mark-icon { flex-shrink: 0; color: var(--cream); }
  .tagline { margin-top: 1rem; max-width: 22rem; opacity: 0.65; font-size: 0.925rem; }

  .col-title { font: 500 0.75rem/1 var(--f-mono); letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.5; margin-bottom: 1rem; }
  .col { display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; }
  .col a { text-decoration: none; color: var(--cream); opacity: 0.75; font-size: 0.925rem; transition: opacity 0.2s; }
  .col a:hover { opacity: 1; }
  .address { max-width: 16rem; }

  .bottom {
    position: relative;
    padding-block: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--cream) 14%, transparent);
    font-size: 0.8rem; opacity: 0.55;
  }

  @media (max-width: 700px) {
    .top { grid-template-columns: 1fr 1fr; }
    .brand-col { grid-column: 1 / -1; }
  }
  @media (max-width: 460px) {
    .top { grid-template-columns: 1fr; }
  }
</style>

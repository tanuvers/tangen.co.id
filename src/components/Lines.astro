---
const lines = [
  {
    tag: 'Divisi · Bisnis & Rekayasa',
    title: 'Tangen Solutions',
    text: 'Menangani sisi bisnis dan rekayasa teknologi kami — baik sebagai software house yang membangun sistem sesuai kebutuhan, maupun vendor yang menyediakan perangkat lunak siap pakai untuk perusahaan.',
  },
  {
    tag: 'Divisi · Edukasi',
    title: 'Tangen Academic',
    text: 'Menangani sisi edukasi kami — dari platform pembelajaran, pelatihan, seminar, hingga penyelenggaraan acara.',
  },
];
---
<section class="section" id="lini">
  <div class="wrap">
    <p class="eyebrow reveal">Lini kerja</p>
    <h2 class="h2 reveal" style="--i:1">Dua lini, satu standar kerja.</h2>
    <p class="lede reveal" style="--i:2">
      PT Tangen Universal Teknologi beroperasi melalui dua divisi terpisah, masing-masing dengan
      fokus dan tim tersendiri.
    </p>

    <ul class="rows">
      {lines.map((l, i) => (
        <li class="row reveal" style={`--i:${i}`}>
          <div class="inner">
            <div class="head">
              <p class="eyebrow">{l.tag}</p>
              <h3>{l.title}</h3>
            </div>
            <div class="body">
              <p>{l.text}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .h2 { margin-bottom: 1.25rem; }
  .lede { max-width: 38rem; font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem); opacity: 0.75; }
  .rows { list-style: none; padding: 0; margin-top: clamp(2.5rem, 6vw, 4.5rem); border-top: 1px solid var(--line); }
  .row {
    position: relative; isolation: isolate;
    padding: clamp(1.75rem, 4vw, 2.75rem) 0; border-bottom: 1px solid var(--line);
    transition: color 0.35s var(--ease);
  }
  .row::before {
    content: ''; position: absolute; inset: 0 calc(var(--gutter) * -1); z-index: -1;
    background: var(--blue); transform: scaleY(0); transform-origin: bottom;
    transition: transform 0.4s var(--ease);
  }
  .inner {
    display: grid; align-items: start; gap: 1.5rem clamp(1.5rem, 4vw, 3.5rem);
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    transition: transform 0.4s var(--ease);
  }
  @media (hover: hover) {
    .row:hover { color: var(--cream); }
    .row:hover::before { transform: scaleY(1); }
    .row:hover .inner { transform: translateX(clamp(0.5rem, 1.5vw, 1rem)); }
  }
  h3 { font: 600 clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem) / 1.1 var(--f-display); letter-spacing: -0.025em; margin-top: 0.85rem; text-wrap: balance; }
  .body p { max-width: 32rem; opacity: 0.85; }

  @media (max-width: 860px) {
    .inner { grid-template-columns: 1fr; }
  }
</style>
